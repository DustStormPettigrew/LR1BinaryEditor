<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LR1BinaryEditor</AssemblyName>
    <RootNamespace>LR1BinaryEditor</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibLR1\LibLR1.csproj" />
  </ItemGroup>

  <!-- Exclude auto-generated WinForms resource files that reference System.Drawing -->
  <ItemGroup>
    <Compile Remove="Properties\Resources.Designer.cs" />
    <Compile Remove="Properties\Settings.Designer.cs" />
    <Compile Remove="LR1BinaryEditor.Tests\**\*.cs" />
    <Compile Remove="LR1BinaryEditor.CorpusValidator\**\*.cs" />
    <EmbeddedResource Remove="Properties\Resources.resx" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Icon.png" />
    <AvaloniaResource Include="Assets\icon_new.png" />
    <AvaloniaResource Include="Assets\icon_open.png" />
    <AvaloniaResource Include="Assets\icon_save.png" />
    <AvaloniaResource Include="..\AppIcons\*.png" Link="Assets\AppIcons\%(Filename)%(Extension)" />
    <AvaloniaResource Include="Assets\FileTypes\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="blocks.cfg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="properties.cfg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\LibLR1\docs\reconciliation\format-evidence.json" Link="format-evidence.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
